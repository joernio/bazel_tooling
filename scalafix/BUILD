load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_library.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# The scalafix rule API. Depend on this to implement custom Scalafix rules.
# The 2.13 artifact is the canonical rule API even for rules compiled with Scala 3.
# The scalameta artifacts are only transitive dependencies of scalafix-core but rules need them directly
# (scala.meta.*), so they are exported here.
java_library(
    name = "scalafix_core",
    exports = [
        "@scalafix_rules_maven//:ch_epfl_scala_scalafix_core_2_13",
        "@scalafix_rules_maven//:org_scalameta_common_2_13",
        "@scalafix_rules_maven//:org_scalameta_common2_2_13",
        "@scalafix_rules_maven//:org_scalameta_metaconfig_core_2_13",
        "@scalafix_rules_maven//:org_scalameta_parsers_2_13",
        "@scalafix_rules_maven//:org_scalameta_scalameta_2_13",
        "@scalafix_rules_maven//:org_scalameta_semanticdb_shared_2_13",
        "@scalafix_rules_maven//:org_scalameta_trees_2_13",
        "@scalafix_rules_maven//:org_scalameta_trees2_2_13",
    ],
)

# The Scalafix testkit to test rules. Tests need scalatest (scala_test) and the properties file
# generated by scalafix_testkit_properties as resource.
java_library(
    name = "scalafix_testkit",
    exports = [
        ":scalafix_core",
        "@scalafix_rules_maven//:ch_epfl_scala_scalafix_testkit_3_8_4",
        "@scalafix_rules_maven//:org_scalameta_io_2_13",
    ],
)

# The Scalafix command line interface.
java_binary(
    name = "scalafix_cli",
    main_class = "scalafix.cli.Cli",
    runtime_deps = ["@scalafix_cli_maven//:ch_epfl_scala_scalafix_cli_2_13_18"],
)

exports_files(["scalafix_runner.sh.tpl"])
